# NoteBro runtime config (adapter-node reads these at RUNTIME, not build time)

# Square hosted payment link for the Digital Cartridge.
# Create a Payment Link in Square Dashboard -> Payment Links, paste the URL here.
# Until this is set, every buy button falls back to the email reserve flow
# instead of a dead link. Price itself lives in src/lib/config/pricing.js.
PUBLIC_SQUARE_CHECKOUT_URL=

# Origin for SvelteKit form/CSRF handling.
ORIGIN=https://notebro.app
